<Application x:Class="PersonalNavigator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#111821"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#17212D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#263241"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F6FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8FA1B5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6EE7D8"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#173C3B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F28B82"/>

    <Style TargetType="Button" x:Key="ChromeButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#202B38"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PillButton" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="#17212D"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="13,7"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0E141C"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="SelectionBrush" Value="#405F59"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5"/>
    </Style>
  </Application.Resources>
</Application>
